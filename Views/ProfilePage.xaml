<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Eventia.Views.ProfilePage"
             BackgroundColor="#12121A"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             Title="Mi Cuenta">

    <Grid>
        <!-- FONDO SEGURO: Mismo formato que el confeti -->
        <Image Source="https://images.unsplash.com/photo-1459749411175-04bf5292ceea?w=800&amp;q=80" Aspect="AspectFill" Opacity="0.25" />

        <ScrollView>
            <VerticalStackLayout Padding="30" Spacing="25" VerticalOptions="CenterAndExpand" Margin="0,20,0,0">

                <VerticalStackLayout x:Name="ContenedorLogo" Spacing="15" HorizontalOptions="Center" Margin="0,0,0,10">
                    <Border BackgroundColor="#2A2A40" WidthRequest="85" HeightRequest="85" StrokeThickness="1.5" Stroke="#5E5CE6" StrokeShape="RoundRectangle 25" HorizontalOptions="Center">
                        <Border.Shadow>
                            <Shadow Brush="#5E5CE6" Offset="0,0" Opacity="0.6" Radius="15" />
                        </Border.Shadow>
                        <Path Data="M22 10V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v4c1.1 0 2 .9 2 2s-.9 2-2 2v4a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-4c-1.1 0-2-.9-2-2s.9-2 2-2zM11 15H9v-2h2v2zm0-4H9V9h2v2zm4 4h-2v-2h2v2zm0-4h-2V9h2v2z" 
                              Fill="#5E5CE6" Aspect="Uniform" WidthRequest="38" HeightRequest="38" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <Label Text="EVENTIA" TextColor="White" FontSize="28" FontAttributes="Bold" CharacterSpacing="4" HorizontalOptions="Center" />
                    <Label Text="Inicia sesión para continuar" TextColor="#A0A0AA" FontSize="14" HorizontalOptions="Center" Margin="0,-5,0,0"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Border BackgroundColor="#1A1A24" Stroke="#2D2D3A" StrokeThickness="1.5" StrokeShape="RoundRectangle 18" Padding="15,5">
                        <Grid ColumnDefinitions="Auto, *">
                            <Path Grid.Column="0" Data="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z" 
                                  Fill="#8E8E93" Aspect="Uniform" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" Margin="0,0,10,0"/>

                            <Entry x:Name="EmailEntry" Grid.Column="1" Placeholder="Correo electrónico / Usuario" PlaceholderColor="#8E8E93" TextColor="White" TextChanged="OnEmailTextChanged" />
                        </Grid>
                    </Border>

                    <Border x:Name="PopupAutocompletar" IsVisible="False" BackgroundColor="#252535" Stroke="#5E5CE6" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="15,10" Margin="20,0,20,0">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,3" Opacity="0.3" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSugerenciaTapped" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                            <Path Data="M7.5 5.6L5 7l1.4-2.5L5 2l2.5 1.4L10 2 8.6 4.5 10 7 7.5 5.6zm12 9.8L17 14l1.4 2.5L17 19l2.5-1.4L22 19l-1.4-2.5L22 14l-2.5 1.4zM22 2l-2.5 1.4L17 2l1.4 2.5L17 7l2.5-1.4L22 7l-1.4-2.5L22 2zm-7.63 5.29c-.39-.39-1.02-.39-1.41 0L1.29 18.96c-.39.39-.39 1.02 0 1.41l2.34 2.34c.39.39 1.02.39 1.41 0L16.71 11.04c.39-.39.39-1.02 0-1.41l-2.34-2.34z" 
                                  Fill="#5E5CE6" Aspect="Uniform" WidthRequest="16" HeightRequest="16" VerticalOptions="Center"/>
                            <VerticalStackLayout>
                                <Label Text="Usar cuenta guardada" TextColor="#A0A0AA" FontSize="10" />
                                <Label x:Name="LabelEmailSugerido" Text="..." TextColor="White" FontSize="13" FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <Border BackgroundColor="#1A1A24" Stroke="#2D2D3A" StrokeThickness="1.5" StrokeShape="RoundRectangle 18" Padding="15,5">
                    <Grid ColumnDefinitions="Auto, *">
                        <Path Grid.Column="0" Data="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z" 
                              Fill="#8E8E93" Aspect="Uniform" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" Margin="0,0,10,0"/>
                        <Entry x:Name="PasswordEntry" Grid.Column="1" Placeholder="Contraseña" IsPassword="True" PlaceholderColor="#8E8E93" TextColor="White" />
                    </Grid>
                </Border>

                <Label Text="¿Olvidaste tu contraseña?" TextColor="#5E5CE6" FontSize="13" FontAttributes="Bold" HorizontalOptions="End" Margin="0,-10,0,5">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnOlvidoPasswordTapped" />
                    </Label.GestureRecognizers>
                </Label>

                <Button x:Name="BtnIngresar" Text="Iniciar Sesión" BackgroundColor="#5E5CE6" TextColor="White" FontSize="18" FontAttributes="Bold" CornerRadius="18" HeightRequest="60" Margin="0,10,0,0" Clicked="OnLoginClicked">
                    <Button.Shadow>
                        <Shadow Brush="#5E5CE6" Offset="0,5" Opacity="0.3" />
                    </Button.Shadow>
                </Button>

                <HorizontalStackLayout HorizontalOptions="Center" Spacing="5" Margin="0,10,0,0">
                    <Label Text="¿No tienes cuenta?" TextColor="#8E8E93" FontSize="14" />
                    <Label Text="Regístrate" TextColor="#5E5CE6" FontSize="14" FontAttributes="Bold">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRegistroTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>